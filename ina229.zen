"""
ina229: INA229-based 85 V power, energy and charge monitor with SPI.

Parts come from github.com/kb1lqc/zener-library (see CLAUDE.md). Pass `ambient` and `derate` to every library
wrapper; an unset ambient reports UNVERIFIED on each part's temperature check.
"""

load("@stdlib/units.zen", "Temperature")
load("@stdlib/interfaces.zen", "Spi")

INA229HighSideMonitor = Module("./modules/INA229HighSideMonitor.zen")

# Board ambient range: 0 to 70 degC, the spec.md requirement (see spec.md, Requirements).
ambient = config(
    Temperature, default="273.15K to 343.15K", help="Board ambient temperature range (set in spec.md first)"
)
derate = config(float, default=1.0, help="Project derating factor in (0, 1]; shrinks abs-max limits only")

# Bus source side (BUS_IN) and load side (BUS_OUT). BUS_OUT also feeds the block's INA229 VBUS sense (DS Fig 10-1
# note 1: load power).
VBUS_IN = Net(voltage="12V to 40V")
VBUS_LOAD = Net(voltage="12V to 40V")
V3V3 = Power("V3V3", voltage="3.3V 3%")  # shared by host and INA229 (spec.md); 3 % keeps logic within VS + 0.3 V
GND = Ground("GND")
ALERT_N = Net("ALERT_N", voltage="0V to 3.399V")
SPI = Spi(
    CS=Net("SPI_CS", voltage="0V to 3.399V"),
    MOSI=Net("SPI_MOSI", voltage="0V to 3.399V"),
    CLK=Net("SPI_CLK", voltage="0V to 3.399V"),
    MISO=Net("SPI_MISO", voltage="0V to 3.399V"),
)

# Full scale: 8 A bidirectional (designer decision 2026-11-15, was 5 A). Basis: balanced rating from the maximum
# full-scale study (docs/design-analysis.md, MF.0 to MF.9; the study's maximum for this part is 9 A).
# rshunt, rshunt_tol: WSK2512R0100BEA (10 mohm, code B +/-0.1 %), designer choice 2026-11-15. Basis: best self-heated
# 8 A error of the candidates that pass +/-1 % (0.626 %, docs/design-analysis.md section 1.4). Availability is FAIR (one
# distributor listing, zero stock in the 2026-11-15 snapshot): OPEN ITEM. Fallback WSK2512R0100DEA (+/-0.5 %, GOOD) fails
# 1 % at 8 A (1.029 %), so it is not a fallback at this current.
# vsense_max: self-heated worst-case Vsense 80.39 mV at 8 A (section 1 and Summary), rounded up to 0.1 mV: 80.4 mV
# (50.9 % ADC headroom to 163.84 mV). Shunt dissipation 0.642 W vs 1 W rating at 70 degC (section 2); element
# 134.3 degC at 70 degC (ESTIMATE, section 3).
INA = INA229HighSideMonitor(
    name="INA",
    BUS_IN=VBUS_IN,
    BUS_OUT=VBUS_LOAD,
    V3V3=V3V3,
    GND=GND,
    SPI=SPI,
    ALERT_N=ALERT_N,
    rshunt="10mohm",
    rshunt_tol="B",
    vsense_max="80.4mV",
    ambient=ambient,
    derate=derate,
)

Board(
    name="ina229",
    path="eda",
    layers=4,
    schematic=True,
)
