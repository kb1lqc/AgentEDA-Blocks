"""
Bench board for the INA229HighSideMonitor block: the reference instance (12-40 V high-side bus, 6 A full scale).
Its gates (build, sync check, ERC) and its arranged sheets are the block's reference; eda/INA.kicad_sch is the
reference sheet that boards stamp per instance (tools/schematic/stamp_block.py).

Parts come from github.com/kb1lqc/zener-library (see CLAUDE.md). Pass `ambient` and `derate` to every library
wrapper; an unset ambient reports UNVERIFIED on each part's temperature check.
"""

load("@stdlib/units.zen", "Temperature")
load("@stdlib/interfaces.zen", "Spi")

INA229HighSideMonitor = Module(
    "github.com/kb1lqc/circuit-blocks/blocks/INA229HighSideMonitor/INA229HighSideMonitor.zen"
)

# Board ambient range: 0 to 70 degC, the block spec.md bench requirement (Requirements).
ambient = config(
    Temperature, default="273.15K to 343.15K", help="Board ambient temperature range (set in spec.md first)"
)
derate = config(float, default=1.0, help="Project derating factor in (0, 1]; shrinks abs-max limits only")

# Bus source side (BUS_IN) and load side (BUS_OUT). BUS_OUT also feeds the block's INA229 VBUS sense (DS Fig 10-1
# note 1: load power).
VBUS_IN = Net(voltage="12V to 40V")
VBUS_LOAD = Net(voltage="12V to 40V")
V3V3 = Power("V3V3", voltage="3.3V 3%")  # shared by host and INA229 (spec.md); 3 % keeps logic within VS + 0.3 V
GND = Ground("GND")
ALERT_N = Net("ALERT_N", voltage="0V to 3.399V")
SPI = Spi(
    CS=Net("SPI_CS", voltage="0V to 3.399V"),
    MOSI=Net("SPI_MOSI", voltage="0V to 3.399V"),
    CLK=Net("SPI_CLK", voltage="0V to 3.399V"),
    MISO=Net("SPI_MISO", voltage="0V to 3.399V"),
)

# Design inputs and their basis; numbers live in docs/design-analysis.md / values.json next to this file (do not copy them here).
# Full scale: 6 A bidirectional, designer choice 2026-11-15. The +/-1 % of reading requirement at 6 A is judged on the
# BOL calibrated, self-heated worst case (docs/design-analysis.md, section 5b; values.json err_fs_cal_pct).
# rshunt, rshunt_tol: WSK2512R0100DEA (10 mohm, code D, +/-0.5 %), designer choice 2026-11-15 (Design definition).
# Availability and lifecycle are not checked in the analysis (open item in spec.md).
# vsense_max: self-heated worst-case Vsense rounded up to 0.1 mV (section 1; values.json vsense_round_up_mv).
INA = INA229HighSideMonitor(
    name="INA",
    BUS_IN=VBUS_IN,
    BUS_OUT=VBUS_LOAD,
    V3V3=V3V3,
    GND=GND,
    SPI=SPI,
    ALERT_N=ALERT_N,
    rshunt="10mohm",
    rshunt_tol="D",
    vsense_max="60.5mV",
    ambient=ambient,
    derate=derate,
)

Board(
    name="INA229HighSideMonitor_bench",
    path="eda",
    layers=4,
    schematic=True,
)
