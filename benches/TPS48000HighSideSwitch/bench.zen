"""
Bench board for the TPS48000HighSideSwitch block: the reference instance (12 V to 40 V high-side bus, 12 V nominal
bench supply). Its gates (build, sync check, ERC) and its arranged sheets are the block's reference; eda/TPS.kicad_sch
is the reference sheet that boards stamp per instance (tools/schematic/stamp_block.py).

Parts come from github.com/kb1lqc/zener-library (see CLAUDE.md). Pass `ambient` and `derate` to every library
wrapper; an unset ambient reports UNVERIFIED on each part's temperature check.
"""

load("@stdlib/units.zen", "Temperature")
load("github.com/kb1lqc/circuit-blocks/blocks/TPS48000HighSideSwitch/reference.zen", "REFERENCE")

TPS48000HighSideSwitch = Module(
    "github.com/kb1lqc/circuit-blocks/blocks/TPS48000HighSideSwitch/TPS48000HighSideSwitch.zen"
)

# Board ambient range: 5 to 40 degC, laboratory (IEC 61010-1 normal environment), spec.md Operating conditions.
ambient = config(
    Temperature, default="278.15K to 313.15K", help="Board ambient temperature range (set in spec.md first)"
)
derate = config(float, default=1.0, help="Project derating factor in (0, 1]; shrinks abs-max limits only")

# Bus source side (BUS_IN) and load side (BUS_OUT). Rated 12 V to 40 V (spec.md Operating conditions).
VBUS_IN = Net(voltage="12V to 40V")
VBUS_OUT = Net(voltage="12V to 40V")
V3V3 = Power("V3V3", voltage="3.3V 3%")  # pull-up rail for FAULT_N and PGOOD_N; 3 % keeps logic within VS + 0.3 V
GND = Ground("GND")
SW_EN = Net("SW_EN", voltage="0V to 3.399V")
SW_FAULT_N = Net("SW_FAULT_N", voltage="0V to 3.399V")
SW_PGOOD_N = Net("SW_PGOOD_N", voltage="0V to 3.399V")

# Design inputs: the reference instance lives in the block package,
# blocks/TPS48000HighSideSwitch/reference.zen, with the basis of each value; numbers live in
# benches/TPS48000HighSideSwitch/docs/design-analysis.md and values.json next to this file.
TPS = TPS48000HighSideSwitch(
    name="TPS",
    BUS_IN=VBUS_IN,
    BUS_OUT=VBUS_OUT,
    EN=SW_EN,
    FAULT_N=SW_FAULT_N,
    PGOOD_N=SW_PGOOD_N,
    V3V3=V3V3,
    GND=GND,
    ambient=ambient,
    derate=derate,
    **REFERENCE,
)

Board(
    name="TPS48000HighSideSwitch_bench",
    path="eda",
    layers=4,
    schematic=True,
)
